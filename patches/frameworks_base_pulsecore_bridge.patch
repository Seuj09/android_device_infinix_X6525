+package com.android.server.power;
+
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.os.BatteryManager;
+import android.os.Handler;
+import android.os.PowerManager;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+
+import com.android.internal.os.BackgroundThread;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Closed-loop ROM-to-PulseCore kernel profile bridge.
+ *
+ * Automatically coordinates Android Battery Saver, GameSpace sessions, and
+ * screen-off unplugged standby with /sys/kernel/pulsecore/profile while
+ * respecting the user's preferred base profile (persist.sys.pulsecore.profile)
+ * and runtime opt-out (persist.sys.pulsecore.auto_profile=false).
+ */
+final class PulseCoreBridge {
+    private static final String TAG = "PulseCoreBridge";
+    private static final String PROFILE_NODE = "/sys/kernel/pulsecore/profile";
+    private static final String PROP_BRIDGE = "ro.pulsecore.bridge";
+    private static final String PROP_AUTO = "persist.sys.pulsecore.auto_profile";
+    private static final String PROP_BASE_PROFILE = "persist.sys.pulsecore.profile";
+    private static final String SETTING_GAMING_ACTIVE = "ax_gaming_mode_active";
+    private static final String DEFAULT_BASE_PROFILE = "smooth";
+
+    private static PulseCoreBridge sInstance;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final PowerManager mPowerManager;
+
+    private boolean mScreenOn = true;
+    private boolean mPluggedIn = false;
+    private boolean mPowerSave = false;
+    private boolean mGamingActive = false;
+    private String mLastApplied = null;
+
+    static void start(Context context) {
+        if (!SystemProperties.getBoolean(PROP_BRIDGE, false)) {
+            return;
+        }
+        if (!new File(PROFILE_NODE).exists()) {
+            Slog.i(TAG, "PulseCore sysfs not present; bridge inactive");
+            return;
+        }
+        synchronized (PulseCoreBridge.class) {
+            if (sInstance == null) {
+                sInstance = new PulseCoreBridge(context);
+                sInstance.init();
+            }
+        }
+    }
+
+    private PulseCoreBridge(Context context) {
+        mContext = context;
+        mHandler = BackgroundThread.getHandler();
+        mPowerManager = context.getSystemService(PowerManager.class);
+    }
+
+    private void init() {
+        mHandler.post(() -> {
+            if (mPowerManager != null) {
+                mScreenOn = mPowerManager.isInteractive();
+                mPowerSave = mPowerManager.isPowerSaveMode();
+            }
+            updateGamingState();
+
+            final IntentFilter filter = new IntentFilter();
+            filter.addAction(Intent.ACTION_SCREEN_ON);
+            filter.addAction(Intent.ACTION_SCREEN_OFF);
+            filter.addAction(Intent.ACTION_BATTERY_CHANGED);
+            filter.addAction(PowerManager.ACTION_POWER_SAVE_MODE_CHANGED);
+
+            final Intent sticky = mContext.registerReceiver(new BroadcastReceiver() {
+                @Override
+                public void onReceive(Context ctx, Intent intent) {
+                    final String action = intent.getAction();
+                    if (action == null) return;
+                    switch (action) {
+                        case Intent.ACTION_SCREEN_ON:
+                            mScreenOn = true;
+                            break;
+                        case Intent.ACTION_SCREEN_OFF:
+                            mScreenOn = false;
+                            break;
+                        case Intent.ACTION_BATTERY_CHANGED:
+                            mPluggedIn = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
+                            break;
+                        case PowerManager.ACTION_POWER_SAVE_MODE_CHANGED:
+                            if (mPowerManager != null) {
+                                mPowerSave = mPowerManager.isPowerSaveMode();
+                            }
+                            break;
+                        default:
+                            return;
+                    }
+                    syncProfileLocked();
+                }
+            }, filter, null, mHandler);
+
+            if (sticky != null) {
+                mPluggedIn = sticky.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
+            }
+
+            final ContentResolver resolver = mContext.getContentResolver();
+            resolver.registerContentObserver(
+                    Settings.Secure.getUriFor(SETTING_GAMING_ACTIVE),
+                    false,
+                    new ContentObserver(mHandler) {
+                        @Override
+                        public void onChange(boolean selfChange) {
+                            updateGamingState();
+                            syncProfileLocked();
+                        }
+                    },
+                    UserHandle.USER_ALL);
+
+            syncProfileLocked();
+            Slog.i(TAG, "Started (base=" + getBaseProfile() + ")");
+        });
+    }
+
+    private void updateGamingState() {
+        mGamingActive = Settings.Secure.getIntForUser(
+                mContext.getContentResolver(),
+                SETTING_GAMING_ACTIVE, 0, UserHandle.USER_CURRENT) == 1;
+    }
+
+    private static String getBaseProfile() {
+        final String p = SystemProperties.get(PROP_BASE_PROFILE, DEFAULT_BASE_PROFILE).trim();
+        switch (p) {
+            case "balanced":
+            case "battery":
+            case "smooth":
+            case "bypass":
+            case "gaming":
+                return p;
+            default:
+                return DEFAULT_BASE_PROFILE;
+        }
+    }
+
+    private void syncProfileLocked() {
+        if (!SystemProperties.getBoolean(PROP_AUTO, true)) {
+            return;
+        }
+        final String target;
+        if (mPowerSave) {
+            target = "battery";
+        } else if (mScreenOn && mGamingActive) {
+            target = "gaming";
+        } else if (!mScreenOn && !mPluggedIn) {
+            // Unplugged screen-off standby: drop to battery profile.
+            // While plugged in + screen off, keep base profile so 80% cap isn't forced.
+            target = "battery";
+        } else {
+            target = getBaseProfile();
+        }
+
+        if (target.equals(mLastApplied)) {
+            return;
+        }
+        if (writeProfile(target)) {
+            mLastApplied = target;
+        }
+    }
+
+    private static boolean writeProfile(String profile) {
+        try (FileOutputStream fos = new FileOutputStream(PROFILE_NODE)) {
+            fos.write((profile + "\n").getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException e) {
+            Slog.w(TAG, "Failed to set PulseCore profile '" + profile + "': " + e.getMessage());
+            return false;
+        }
+    }
+}
