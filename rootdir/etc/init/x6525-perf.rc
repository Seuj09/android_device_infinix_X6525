# SPDX-FileCopyrightText: The LineageOS Project
# SPDX-License-Identifier: Apache-2.0
#
# Runtime performance, storage, memory, and PulseCore v0.8.0 sync
# for Infinix Smart 8 (X6525 / ums9230).

on post-fs-data
    # Override stock Android 13 Go tiny Dalvik heap set by vendor init.md.rc on early-init
    # so full Android 16 apps and SystemUI don't suffer constant GC pauses / OOM reloads.
    setprop dalvik.vm.heapstartsize 8m
    setprop dalvik.vm.heapgrowthlimit 192m
    setprop dalvik.vm.heapsize 512m
    setprop dalvik.vm.heaptargetutilization 0.6
    setprop dalvik.vm.heapminfree 8m
    setprop dalvik.vm.heapmaxfree 16m
    setprop dalvik.vm.madvise-random false

on boot
    # Grant system_server access to PulseCore v0.8.0 profile/thermflow controls.
    chown system system /sys/kernel/pulsecore/profile
    chown system system /sys/kernel/pulsecore/enabled
    chown system system /sys/kernel/pulsecore/thermflow/bypass
    chown system system /sys/kernel/pulsecore/thermflow/charge_cap_enabled
    chmod 0664 /sys/kernel/pulsecore/profile
    chmod 0664 /sys/kernel/pulsecore/enabled
    chmod 0664 /sys/kernel/pulsecore/thermflow/bypass
    chmod 0664 /sys/kernel/pulsecore/thermflow/charge_cap_enabled

on property:persist.sys.pulsecore.profile=*
    write /sys/kernel/pulsecore/profile ${persist.sys.pulsecore.profile}

on property:sys.boot_completed=1
    # Re-ensure PulseCore permissions after late_initcall completes and apply base profile.
    chown system system /sys/kernel/pulsecore/profile
    chown system system /sys/kernel/pulsecore/enabled
    chown system system /sys/kernel/pulsecore/thermflow/bypass
    chown system system /sys/kernel/pulsecore/thermflow/charge_cap_enabled
    chmod 0664 /sys/kernel/pulsecore/profile
    chmod 0664 /sys/kernel/pulsecore/enabled
    chmod 0664 /sys/kernel/pulsecore/thermflow/bypass
    chmod 0664 /sys/kernel/pulsecore/thermflow/charge_cap_enabled
    write /sys/kernel/pulsecore/profile ${persist.sys.pulsecore.profile:-smooth}

    # Ensure schedutil is active on both clusters with stock Unisoc tuning.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/freq_margin 30
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/freq_margin 30
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/rate_limit_us 10000

    # VM tuning synced 1:1 with PulseCore v0.8.0 (MemPulse 4GB tier, SwapFlow,
    # WriteFlow, SlabShield) and ~3.85 GB lz4kd ZRAM. Leave MGLRU min_ttl_ms to
    # PulseCore MemPulse so per-profile & touch TTL boosts are never overwritten.
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 130
    write /proc/sys/vm/direct_swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 60
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/watermark_scale_factor 20
    write /sys/kernel/mm/lru_gen/enabled y
    write /proc/sys/vm/kcompressd 0

    # eMMC + ADIOS I/O queue tuning (aligned with 256K readahead & IOFlow).
    write /sys/block/mmcblk0/queue/read_ahead_kb 256
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/add_random 0
    write /sys/block/mmcblk0/queue/rq_affinity 2
    write /sys/block/mmcblk0/queue/iostats 0

    # Network stack: Google BBRv3 + ECN + TCP Fast Open.
    write /proc/sys/net/ipv4/tcp_congestion_control bbr3
    write /proc/sys/net/ipv4/tcp_ecn 1
    write /proc/sys/net/ipv4/tcp_fastopen 3
