#
# Vendor properties for Infinix Smart 8 (X6525 / ums9230).
#
# IMPORTANT: these were seeded from a known ums9230 Transsion tree. Some
# reference props came from a T616 sibling and are *wrong* for the T606 used
# here (that is why ro.soc.model is overridden below). Always diff this file
# against /vendor/build.prop from your own dump:
#
#     python3 tools/collect-props.py <dump> > props.dump.txt
#
# and keep the values your device actually reports.

# ---- SoC -------------------------------------------------------------------
# Verified from stock device getprop (ro.soc.* reports Spreadtrum/T616 even
# though the efuse/marketing chip is T606).
ro.soc.manufacturer=Spreadtrum
ro.soc.model=T616

# ---- Audio -----------------------------------------------------------------
ro.hardware.audio.primary=whale
ro.vendor.audio.whale_hal=true
ro.vendor.audio.version=V1.6.1-20240124
ro.vendor.mmi.use.audio.whale.hal=1
persist.sys.audio.source=true
ro.vendor.af.bt_fc_multiplier=1
ro.vendor.af.dup_multiplier=2
ro.vendor.af.raise_bt_thread_prio=true
ro.vendor.ag.log=/dev/audio_dsp_log
ro.vendor.ag.pcm=/dev/audio_dsp_pcm
ro.vendor.ag.mem=/dev/audio_dsp_mem
persist.audio.bigvolume.enabled=true
persist.audio.bigvolume.switch=false
persist.vendor.audio.hifi_enabled=false
ro.audio.offload_wakelock=false
ro.af.client_heap_size_kbyte=2049

# ---- Bluetooth -------------------------------------------------------------
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.aidl_flag=aidl
persist.bluetooth.a2dp_offload.cap=sbc
persist.bluetooth.a2dp_offload.switch=true
ro.bt.bdaddr_path=/data/vendor/bluetooth/btmac.txt
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true

# ---- Display / graphics ----------------------------------------------------
ro.hardware.hwcomposer=unisoc
ro.hardware.enhance=unisoc
ro.hardware.gsp=unisoc
ro.hardware.dpu=unisoc
ro.opengles.version=196610
# Stock /vendor/lib/egl only contains libGLES_mali.so; without this libEGL does
# not know which vendor EGL implementation to load.
ro.hardware.egl=mali
# Display tuning data (DTS) shipped in /vendor/etc/dts.
ro.vendor.dts.cfgpath=/vendor/etc/dts/
ro.vendor.dts.licensepath=/vendor/etc/dts/
ro.vendor.gpu.boost=1
debug.renderengine.backend=skiaglthreaded
debug.sf.auto_latch_unsignaled=true
debug.sf.enable_skip_rotation=1
debug.sf.treat_170m_as_sRGB=1
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.present_time_offset_from_vsync_ns=0
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.start_graphics_allocator_service=false
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.use_context_priority=true
ro.surface_flinger.use_vr_flinger=false
ro.surface_flinger.vsync_event_phase_offset_ns=1000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=1000000
ro.vendor.display.sr=true
ro.vendor.displayenhance=true
ro.vendor.nightdisplay.enhance=true
# Disable Unisoc DPU CABC backlight throttling so max slider reaches full brightness
persist.sys.pq.cabc.enabled=0
persist.sys.pq.dci.enabled=1
persist.sys.pq.enabled=1
persist.sys.sf.color_saturation=1.0
ro.vendor.arm.gralloc.no_afbc_usage_flags=0x20000000
ro.vendor.arm.gralloc.no_afbc_usage_mask=0x60000000
ro.vendor.arm.gralloc.force_back_buffer_usage_flags=0x40000000000000
ro.vendor.arm.gralloc.force_back_buffer_usage_mask=0x40000000000000
ro.vendor.arm.gralloc.shared_access_usage_flags=0x10000000
ro.vendor.arm.gralloc.shared_access_usage_mask=0x50000000
ro.vendor.arm.gralloc.afrc_rgba_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_rgba_usage_mask=0x70000000
ro.vendor.arm.gralloc.afrc_luma_usage_flags=0x50000000,0x60000000,0x40000000
ro.vendor.arm.gralloc.afrc_luma_usage_mask=0x70000000
ro.vendor.arm.gralloc.afrc_chroma_usage_flags=0x100000000000000,0x80000000000000,0x180000000000000
ro.vendor.arm.gralloc.afrc_chroma_usage_mask=0x180000000000000
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.hal_format=0x1
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.recordable=true
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.hal_format=0x4
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.hal_format=0x2b
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.hal_format=0x16
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.recordable=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.framebuffer_target=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.hal_format=0x23
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_yuv_special.framebuffer_target=false

# ---- Sensors ---------------------------------------------------------------
ro.hardware.sensors=unisoc
ro.vendor.acc_x_abs_rang=2
ro.vendor.acc_y_abs_rang=2
ro.vendor.acc_z_abs_rang_min=7.3
ro.vendor.acc_z_abs_rang_max=12.3
ro.vendor.acc_xyz_offset=0.5
ro.vendor.ps_ground_noise_range_min=0
ro.vendor.ps_ground_noise_range_max=5000
ro.vendor.ps_threshold_low_change_min=20
ro.vendor.ps_threshold_low_change_max=600
ro.vendor.ps_threshold_high_sub_low_min=20
ro.vendor.ps_threshold_high_change_max=1200
ro.vendor.light_k_range_min=0.25
ro.vendor.light_k_range_max=2.5
ro.vendor.light_zero_lux_range_min=0
ro.vendor.light_zero_lux_range_max=40

# ---- Wi-Fi / WCN -----------------------------------------------------------
wifi.interface=wlan0
wifi.direct.interface=p2p-dev-wlan0
wlan.driver.status=ok
ro.vendor.wcn.hardware.etcpath=/odm/firmware
ro.vendor.modem.wcn.count=1
ro.vendor.modem.wcn.enable=1
ro.vendor.modem.wcn.id=1
ro.vendor.modem.wcn.diag=/dev/slog_wcn0
persist.vendor.wcn.log_dest=0
persist.vendor.sys.wcnreset=1
persist.vendor.sys.wcnstate=0
ro.vendor.modem.gnss.log=/dev/slog_gnss
ro.vendor.modem.gnss.diag=/dev/wcn_gnss_dump
ro.vendor.sp.gnss.coupling=0

# ---- Radio / modem ---------------------------------------------------------
ro.telephony.default_network=9
ro.vendor.radio.modemtype=l
ro.vendor.modem.support=1
ro.vendor.modem.dev=/proc/cptl/
ro.vendor.modem.tty=/dev/stty_lte
ro.vendor.modem.loop=/dev/spipe_lte0
ro.vendor.modem.nv=/dev/spipe_lte1
ro.vendor.modem.diag=/dev/sdiag_lte
ro.vendor.modem.log=/dev/slog_lte
ro.vendor.modem.assert=/dev/spipe_lte2
ro.vendor.modem.fixnv_size=0x100000
ro.vendor.modem.runnv_size=0x120000
ro.vendor.modem.nvpacket_size=0x400
ro.vendor.modem.tmctl=/dev/sprd_time_sync
ro.vendor.modem.tmtsf=/dev/stime_pm
ro.vendor.modem.eth=seth_lte
ro.vendor.modem.snd=1
ro.vendor.ldsp.log=/dev/slog_ldsp
ro.vendor.sp.dev=/proc/pmic/
ro.vendor.sp.log=/dev/slog_pm
ro.vendor.ko.mount.point=/mnt/vendor
ro.vendor.product.partitionpath=/dev/block/by-name/
persist.vendor.modem.nvp=l_
persist.vendor.modem.l.enable=1
persist.vendor.modem.notsyncfixnv=0
persist.vendor.modem.log_dest=0
persist.vendor.sys.isfirstboot=1
persist.vendor.sys.modemreset=1
persist.vendor.sys.modem.save_dump=1
persist.vendor.sys.modem.diag=disable
persist.vendor.sys.single.imsstack=true
persist.sys.wfc.supp_dual_sim=true
persist.vendor.sys.volte.enable=true
persist.vendor.radio.imsua.setting=1
persist.vendor.bsservice.enable=1
persist.vendor.eng.reset=2
persist.vendor.eng.jeita=1
persist.sys.log.yloglite=0
ro.rebootescrow.device=/dev/block/pmem0

# ---- Camera ----------------------------------------------------------------
ro.camera.enableLazyHal=true
ro.camerax.extensions.enabled=false
camera.disable_zsl_mode=1
persist.vendor.cam.brand=transsion
persist.vendor.cam.prevvideohw3dnr.config=b8603
persist.vendor.cam.rear.morpho.hdsr.bvup=220
persist.vendor.cam.rear.morpho.hdsr.bvdown=200
persist.vendor.cam.front.morpho.hdsr.bvup=10
persist.vendor.cam.front.morpho.hdsr.bvdown=-10
persist.vendor.cam.rear.morpho.hdsr.iso=10000
persist.vendor.cam.front.morpho.hdsr.iso=6399
persist.vendor.cam.front.supernight.bv.thrd.up.common=600
persist.vendor.cam.front.supernight.iso.thrd.up.common=0
persist.vendor.cam.rear.supernight.bv.thrd.up.common=600
persist.vendor.cam.rear.supernight.bv.thrd.up.ov13b10_1893_13M=600
persist.vendor.cam.rear.supernight.iso.thrd.up.common=0
persist.vendor.cam.rear.supernight.iso.thrd.up.ov13b10_1893_13M=0

# ---- Storage ---------------------------------------------------------------
ro.storage.flash_type=2
external_storage.casefold.enabled=1
external_storage.projid.enabled=1
external_storage.sdcardfs.enabled=0

# ---- Fingerprint / TEE -----------------------------------------------------
ro.vendor.fps.support=true
persist.vendor.debug.fp.support=false
ro.vendor.tee.gpapi.support=true
ro.vendor.keybox.id.value=NO_CHECK
persist.fingerprint.location=RIGHT

# ---- Media / DRM -----------------------------------------------------------
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.media.omx=0
ro.vendor.media.wfd.resolution=2
drm.service.enabled=true

# ---- Power / LMK / ZRAM ----------------------------------------------------
ro.lmk.critical_upgrade=true
ro.lmk.kill_heaviest_task=false
ro.lmk.upgrade_pressure=60
ro.lmk.downgrade_pressure=80
ro.lmk.filecache_min_kb=65536
ro.lmk.kill_timeout_ms=100
ro.lmk.lowmem_min_oom_score=1001
ro.lmk.psi_partial_stall_ms=100
ro.lmk.psi_complete_stall_ms=700
ro.lmk.relaxed_available_memory=true
ro.lmk.stall_limit_critical=40
ro.lmk.swap_compression_ratio=2
ro.lmk.swap_compression_ratio_div=1
ro.lmk.swap_free_low_percentage=5
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.thrashing_limit_critical=500
persist.vendor.powerhint.hint.enable=true
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=180
ro.zram.periodic_wb_delay_hours=24

# ---- Virtual A/B -----------------------------------------------------------
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.compression.xor.enabled=false
ro.virtual_ab.io_uring.enabled=false
ro.virtual_ab.userspace.snapshots.enabled=true

# ---- Misc ------------------------------------------------------------------
ro.frp.pst=/dev/block/by-name/persist
ro.oem_unlock_supported=1
ro.incremental.enable=module:/vendor/lib/modules/incrementalfs.ko
service.wait_for_bootanim=1
# Transsion device-name default used by the stock vendor components.
ro.product.vendor.tran.device.name.default=Infinix SMART 8
vendor.prop.turbo.cloud=0
persist.sys.zram_enabled=1
persist.sys.usb.config=adb
ro.vndk.version=33
sys.usb.controller=musb-hdrc.1.auto
